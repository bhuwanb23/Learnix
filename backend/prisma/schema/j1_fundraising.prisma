// Domain J1 — Fundraising campaigns + donations.
// Docs: 12-alumni-relations.md §3.4 · 05-state-machines.md §donation
// Record flow: donation PLEDGED → on receipt, create Payment(category DONATION)
// + Receipt + DonationPayment link, then donation.status = RECEIVED with
// paymentId set. raisedMinor is denormalized (sum of RECEIVED donations).
// alumniUserId scalar → users.id (alumni are users).

model FundraisingCampaign {
  id            String    @id @default(cuid())
  institutionId String
  name          String
  description   String?
  targetMinor   Int
  raisedMinor   Int       @default(0) // denorm — service-updated on donation receipt
  deadline      DateTime?
  status        String    @default("ACTIVE") // ACTIVE | COMPLETED
  // ── Cause / project detail ──
  // A campaign used to be a name and one sentence, which is not enough to decide
  // whether to give: what the money is FOR, who benefits, and what it looks like.
  // `category` drives the icon and the filter chips; `beneficiary` is the plain
  // sentence a donor reads before committing ("80 scholarships for first-years").
  category      String?   // SCHOLARSHIP | INFRASTRUCTURE | LIBRARY | RESEARCH | SPORTS | GENERAL
  beneficiary   String?
  imageUrl      String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  donations Donation[]
  // Chapter initiatives that raise money through this campaign. The initiative
  // stores no amount of its own — it reads raisedMinor from here, so the two can
  // never disagree.
  chapterInitiatives AlumniChapterInitiative[]
  recurringContributions RecurringContribution[]

  @@unique([institutionId, name])
  @@index([institutionId])
  @@index([status])
  @@map("fundraising_campaigns")
}

model Donation {
  id           String    @id @default(cuid())
  institutionId String
  campaignId   String? // optional — unrestricted gifts allowed
  alumniUserId String // scalar → users.id
  fund         String // GENERAL | LIBRARY | SCHOLARSHIP | INFRASTRUCTURE
  amountMinor  Int
  status       String    @default("PLEDGED") // PLEDGED | RECEIVED
  receivedAt   DateTime?
  paymentId    String? // scalar → payments.id (set by the write-through)
  // ── One-time vs recurring ──
  // NULL recurringId = a one-off gift. Non-null = this row was generated by a
  // mandate, so "what does this alumnus give regularly?" is answerable with one
  // indexed lookup instead of replaying a schedule.
  recurringId  String?
  // Chosen by the donor at pledge time (UPI | NET_BANKING | CARD | CASH). The
  // Payment row is the authority once the office records the money; this is what
  // the donor said they used.
  method       String?
  // Donor dedication: "in memory of my father". Shown on the receipt.
  note         String?
  // ── Anonymity ──
  // Public-facing anonymity only. The office still reads alumniUserId, because
  // 80G receipts and bank reconciliation need the real donor; every non-office
  // caller gets "Anonymous" instead of the name. Masking happens in the service,
  // never in the client, so the name is never sent to a phone that must not have it.
  isAnonymous  Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  campaign     FundraisingCampaign? @relation(fields: [campaignId], references: [id])
  alumniUser   User @relation(fields: [alumniUserId], references: [id])
  paymentLinks DonationPayment[]
  recurring    RecurringContribution? @relation(fields: [recurringId], references: [id])

  @@index([alumniUserId])
  @@index([campaignId])
  @@index([status])
  @@index([recurringId])
  @@index([institutionId, createdAt])
  @@map("donations")
}

/// A standing instruction to give a fixed amount on a cadence.
///
/// Not a scheduler. There is no cron in this app, so a mandate is a RECORD of
/// intent plus a `nextDueAt` the office acts on ("Charge due mandates"). That
/// choice is deliberate: an in-process timer would silently stop whenever the
/// server restarts and would leave no audit trail, whereas a button press is
/// attributable and idempotent per due date.
model RecurringContribution {
  id             String    @id @default(cuid())
  institutionId  String
  donorUserId    String // scalar → users.id
  campaignId     String? // null = an unrestricted standing gift
  fund           String
  amountMinor    Int
  cadence        String    @default("MONTHLY") // MONTHLY | QUARTERLY | SEMI_ANNUAL | ANNUAL
  status         String    @default("ACTIVE") // ACTIVE | PAUSED | CANCELLED | COMPLETED
  nextDueAt      DateTime?
  lastChargedAt  DateTime?
  /// Guards double-charging: the office action is safe to press twice because a
  /// mandate whose `lastChargedAt` is already >= its `nextDueAt` is skipped.
  chargedThrough DateTime?
  note           String?
  /// Carried onto every instalment this mandate generates. Without it, a donor who
  /// signed up to give anonymously would become the named donor of record the
  /// first time a machine charged them.
  isAnonymous    Boolean   @default(false)
  cancelledAt    DateTime?
  cancelReason   String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  donor     User @relation(fields: [donorUserId], references: [id])
  campaign  FundraisingCampaign? @relation(fields: [campaignId], references: [id])
  donations Donation[]

  @@index([donorUserId])
  @@index([institutionId, status])
  @@index([status, nextDueAt])
  @@map("recurring_contributions")
}
