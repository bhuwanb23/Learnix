// Domain E1 — Fee structures (per program × academic year) and student dues.
// Docs: 03-admin.md §3.13 · 06-accounts-finance.md §3.3 · §3.5
// All money = Int paise. requestedByUserId scalar actor-stamp.
// daysOverdue is denormalized, recomputed by the dues-reminder job.

model FeeStructure {
  id             String   @id @default(cuid())
  institutionId  String
  programId      String
  academicYearId String
  // The headline totals, DENORMALISED from the published version's components.
  // `tuitionMinor` is the sum of every TUITION component, `otherMinor` every
  // non-tuition component, `totalMinor` the whole published version. They are
  // recomputed on publish, never edited by hand — three columns that the dues
  // desk and the dashboard read on every request, and which used to be three
  // numbers typed in by hand that silently disagreed with the breakdown printed
  // beside them.
  tuitionMinor   Int
  otherMinor     Int      @default(0)
  totalMinor     Int
  status         String   @default("ACTIVE") // ACTIVE | REVISION_REQUESTED | REVISION_APPROVED
  requestedByUserId String? // scalar → users.id
  // Effective window of the PUBLISHED version. A due raised on a date inside
  // this window bills the version that was in force on THAT date, not the one
  // in force today — a structure revised in November must not retroactively
  // reprice a bill raised in July.
  effectiveFrom  DateTime?
  effectiveTo    DateTime?
  // The published version the totals above were computed from. Null only for
  // structures created before versioning existed (the seed backfills them).
  publishedVersionId String? // scalar → fee_structure_versions.id
  // DEFAULT instalment configuration offered when a bill is raised against this
  // structure. The actual plan is still agreed per student (`InstallmentPlan`)
  // — this is the menu, not the meal. `defaultInstallments: 1` means "pay it in
  // one go", which is the default precisely because a plan is a concession.
  defaultInstallments Int    @default(1)
  defaultFrequency    String @default("ONE_TIME") // ONE_TIME | MONTHLY | QUARTERLY | TRIMESTER | SEMESTERLY
  defaultFirstDueDays Int    @default(30) // days after the academic year starts that instalment 1 falls due
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  program      Program      @relation(fields: [programId], references: [id])
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id])
  dues         FeeDue[]
  lateFeeRules LateFeeRule[]
  components   FeeComponent[]
  versions     FeeStructureVersion[]
  concessions  FeeConcession[]
  @@unique([programId, academicYearId])
  @@index([institutionId])
  @@map("fee_structures")
}

// ── Fee components ───────────────────────────────────────────
// Docs: 06-accounts-finance.md §3.5.1
//
// A structure used to be three integers — tuition, other, total — which cannot
// answer "what is the hostel charge", "does the exam fee differ by semester" or
// "we waived the library charge, what is left". A component is one real charge
// line: tuition for semester 3, the exam fee, the hostel rent, a one-off
// admission charge. The totals are derived from these rows, never typed beside
// them.
model FeeComponent {
  id             String   @id @default(cuid())
  institutionId  String
  feeStructureId String
  // TUITION | EXAMINATION | HOSTEL | LIBRARY | ADMISSION | TRANSPORT | OTHER.
  // Only TUITION and EXAMINATION are charges every student always pays; the
  // rest are optional or resident-only, which is why `optional` exists and why
  // a default plan has to be computed rather than assumed.
  kind           String
  label          String
  amountMinor    Int
  // 1..8. Semester-specific charges (semester 3 tuition is usually not the same
  // as semester 1). `semester: 0` means the charge applies to EVERY semester of
  // the year and is reported on the annual total.
  semester       Int      @default(0)
  // A charge a student can decline (hostel, transport). Included in the annual
  // headline only when a plan says so; never silently added to what is owed.
  optional       Boolean  @default(false)
  // Applies to new admissions this year only (an admission charge, a one-time
  // orientation fee). Kept so a structure can say "everyone pays this except
  // second-years" without inventing a second program.
  firstYearOnly  Boolean  @default(false)
  sortOrder      Int      @default(0)
  note           String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  feeStructure FeeStructure @relation(fields: [feeStructureId], references: [id])

  @@index([feeStructureId, semester])
  @@index([institutionId, kind])
  @@map("fee_components")
}

// ── Version history ──────────────────────────────────────────
// Docs: 06-accounts-finance.md §3.5.6
//
// A version is an IMMUTABLE snapshot of a structure's components plus its
// effective window. Editing a published structure creates the NEXT version
// rather than mutating the old one, so "what did semester 3 cost in 2024-25"
// stays answerable after the 2026-27 rates are published. Snapshots the
// components as JSON rather than referencing live rows precisely because
// `FeeComponent` rows are mutable — a snapshot pointing at live rows would
// rewrite its own history every time a rate changed.
model FeeStructureVersion {
  id             String   @id @default(cuid())
  institutionId  String
  feeStructureId String
  // 1, 2, 3… within one structure. Unique per structure.
  versionNo      Int
  // DRAFT (editable, bills nothing) | PUBLISHED (in force) | SUPERSEDED (was in
  // force, now replaced) | DRAFT_DISCARDED.
  status         String   @default("DRAFT")
  effectiveFrom  DateTime
  effectiveTo    DateTime?
  // [{kind,label,amountMinor,semester,optional,firstYearOnly}] at the moment
  // this version was cut. This is the historical record.
  componentsJson String
  tuitionMinor   Int      @default(0)
  otherMinor     Int      @default(0)
  totalMinor     Int      @default(0)
  // Why the rates moved. A version history with no reasons is a spreadsheet.
  changeNote     String?
  createdByUserId String? // scalar → users.id
  publishedByUserId String? // scalar → users.id
  publishedAt    DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  feeStructure FeeStructure @relation(fields: [feeStructureId], references: [id])

  @@unique([feeStructureId, versionNo])
  @@index([institutionId, status])
  @@index([feeStructureId, effectiveFrom])
  @@map("fee_structure_versions")
}

// ── Concession / scholarship rules ───────────────────────────
// Docs: 06-accounts-finance.md §3.5.4
//
// `Scholarship` records who got money. THIS records what the institution's
// POLICY is — "50% off tuition for the top 5% of each batch", "full waiver of
// the exam fee for staff ward" — so that applying a concession is arithmetic
// against a written rule rather than a judgement call made under pressure at
// the counter. An award that does not name the rule it came from cannot be
// defended at audit.
model FeeConcession {
  id             String   @id @default(cuid())
  institutionId  String
  feeStructureId String
  name           String
  // MERIT | NEED_BASED | SIBLING | STAFF_WARD | SCHOLARSHIP | OTHER
  kind           String   @default("SCHOLARSHIP")
  // PERCENT (valueBp basis points off the eligible charges) | FLAT (a fixed
  // rupee amount off the eligible charges). NEVER a negative.
  basis          String   @default("PERCENT")
  valueBp        Int      @default(0)
  amountMinor    Int      @default(0)
  // Which charges the concession may touch: ALL | TUITION | EXAMINATION | HOSTEL
  // | LIBRARY | ADMISSION | TRANSPORT | OTHER. Scoped because waiving 50% of
  // "everything" quietly waives the hostel bill of a student who was not even
  // living in the hostel.
  appliesTo      String   @default("TUITION")
  // 0 = every semester.
  semester       Int      @default(0)
  enabled        Boolean  @default(true)
  note           String?
  createdByUserId String? // scalar → users.id
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  feeStructure FeeStructure @relation(fields: [feeStructureId], references: [id])

  @@index([feeStructureId, enabled])
  @@index([institutionId, kind])
  @@map("fee_concessions")
}

model FeeDue {
  id               String    @id @default(cuid())
  studentProfileId String
  feeStructureId   String?
  title            String // "Sem 4 Tuition", "Exam Fee"…
  amountMinor      Int
  dueDate          DateTime
  status           String    @default("UNPAID") // UNPAID | PARTIAL | CLEARED | WAIVED
  waivedReason     String?
  // What has actually been paid against this due. `status` alone could not say:
  // a payment that covers half a due looks identical to one that covers none.
  // balance = amountMinor - paidMinor, and status is derived from that.
  paidMinor        Int       @default(0)
  lastPaymentAt    DateTime?
  // Late-payment fine, assessed from the institution's LateFeeRule. It is
  // stored on the due rather than shown live, because a fine that is only ever
  // "estimated" is a fine nobody can collect, dispute or reverse. balance =
  // amountMinor + lateFeeMinor - paidMinor (see dues.money.ts).
  lateFeeMinor     Int       @default(0)
  lateFeeRuleId    String?   // scalar → late_fee_rules.id
  lateFeeAssessedAt DateTime?
  lateFeeAssessedByUserId String? // scalar → users.id
  // Installment plan. A plan REPLACES this due with N child FeeDue rows (one
  // per instalment), so the parent becomes SUPERSEDED — a decision, not a
  // calculation, which is why deriveDueStatus() preserves it.
  installmentPlanId String?   // scalar → installment_plans.id
  installmentSequence Int?
  supersededByPlanId String?  // scalar → installment_plans.id
  // Recovery tracking. The old desk sent a reminder and immediately forgot
  // about it, so nobody could tell a family that had never been chased from
  // one that had been asked six times.
  lastRemindedAt   DateTime?
  reminderCount    Int       @default(0)
  // Who waived it, when, and why. A waiver with no actor is an unauditable one.
  waivedAt         DateTime?
  waivedByUserId   String?   // scalar → users.id
  daysOverdue      Int       @default(0) // denorm, job-recomputed
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  studentProfile StudentProfile @relation(fields: [studentProfileId], references: [id])
  feeStructure   FeeStructure?  @relation(fields: [feeStructureId], references: [id])
  allocations    PaymentAllocation[]
  installmentPlan InstallmentPlan? @relation("InstallmentPlanChildren", fields: [installmentPlanId], references: [id])

  @@index([studentProfileId])
  @@index([status])
  @@index([installmentPlanId])
  @@map("fee_dues")
}

// ── Late-payment fines ────────────────────────────────────────
// Docs: 06-accounts-finance.md §3.3
//
// A fine is a POLICY decision, so it is configured per institution rather than
// hard-coded: some colleges charge nothing, some charge a flat ₹500 the month
// after the due date. The rule only ever produces a NUMBER; a due is what
// actually carries an assessed fine (`FeeDue.lateFeeMinor`), because an
// unassessed, unstored fine cannot be collected, disputed or reversed.
model LateFeeRule {
  id             String   @id @default(cuid())
  institutionId  String
  // Optional link to the fee structure this applies to. NULL = applies to every
  // fee at the institution, which is the common case.
  feeStructureId String?
  name           String   @default("Late payment fine")
  enabled        Boolean  @default(true)
  // Days after the due date before the fine starts accruing — the grace period.
  graceDays      Int      @default(0)
  // PERCENT charges `valueBp` basis points of the outstanding BALANCE for each
  // started month or part-month past grace. FLAT charges `flatMinor` for each
  // such month. Both are capped by `capBp` of the due's billed amount.
  mode           String   @default("PERCENT") // PERCENT | FLAT
  valueBp        Int      @default(100)      // 100bp = 1% per started month
  flatMinor      Int      @default(0)
  // Cap as basis points of amountMinor; 10000 = 100% (no cap). `maxMonths` of
  // 0 means the fine keeps accruing until the cap.
  capBp          Int      @default(10000)
  maxMonths      Int      @default(0)
  createdByUserId String? // scalar → users.id
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  feeStructure FeeStructure? @relation(fields: [feeStructureId], references: [id])

  @@index([institutionId, enabled])
  @@map("late_fee_rules")
}

// ── Payment plans / instalments ───────────────────────────────
// Docs: 06-accounts-finance.md §3.3
//
// An instalment plan REPLACES the original due with N real FeeDue rows, one per
// instalment. That is deliberate: each instalment is then an ordinary bill — it
// ages, it can be collected against, it can be reminded or waived on its own,
// and it shows up in the aging strip. A plan stored as a side table tracking
// progress on an un-splittable due would be a schedule nobody could collect
// against and no one could chase.
model InstallmentPlan {
  id             String   @id @default(cuid())
  institutionId  String
  parentDueId    String   // the due this plan replaces
  totalMinor     Int      // snapshot of the parent's balance at agreement time
  count          Int      // number of instalments, 2..12
  frequency      String   @default("MONTHLY") // MONTHLY | WEEKLY | FORTNIGHTLY
  startDate      DateTime // due date of instalment 1
  note           String?  // "agreed with father over the phone, 10 Mar"
  status         String   @default("ACTIVE") // ACTIVE | CANCELLED | COMPLETED
  createdByUserId String? // scalar → users.id
  cancelledAt    DateTime?
  cancelledByUserId String?
  cancelReason   String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  children FeeDue[] @relation("InstallmentPlanChildren")

  @@index([institutionId, status])
  @@index([parentDueId])
  @@map("installment_plans")
}
