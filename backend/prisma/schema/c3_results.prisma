// Domain C3 — Hall tickets, evaluation workflow, results, re-evaluation, cheating.
// Docs: 05-exam-cell.md §3.3–3.6 · 05-state-machines.md §cheating
// evaluatorUserId/publishedByUserId/decidedByUserId/reviewedByUserId are scalar
// actor-stamps. NOTE: cheating status is DISMISSED (05 doc spelling; 02 had a typo).

model HallTicket {
  id               String    @id @default(cuid())
  examSlotId       String
  studentProfileId String
  seatNo           String
  qrPayload        String?
  status           String    @default("GENERATED") // GENERATED | DOWNLOADED | NOT_GENERATED
  generatedAt      DateTime  @default(now())
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  examSlot       ExamSlot       @relation(fields: [examSlotId], references: [id])
  studentProfile StudentProfile @relation(fields: [studentProfileId], references: [id])
  hallTicketRequests HallTicketRequest[]

  @@unique([examSlotId, studentProfileId])
  @@unique([examSlotId, seatNo])
  @@index([examSlotId])
  @@index([studentProfileId])
  @@map("hall_tickets")
}

// X-04 — correction and reissue requests. ONE table for both kinds, because the
// queue, the decision and the audit trail are one workflow and two tables would
// be two copies of it drifting apart. `field`/`requestedValue` are only
// meaningful for a CORRECTION; a REISSUE regenerates seat + QR when completed.
//
// A student ASKS; only the exam cell decides. That asymmetry is why
// `decidedByUserId` is stamped rather than trusted from the request body.
model HallTicketRequest {
  id               String    @id @default(cuid())
  hallTicketId     String
  studentProfileId String
  kind             String // CORRECTION | REISSUE
  field            String? // CORRECTION only: seatNo | rollNo | fullName
  requestedValue   String? // CORRECTION only: what it should say instead
  reason           String
  status           String    @default("REQUESTED") // REQUESTED | APPROVED | REJECTED | COMPLETED
  note             String? // decision note — what was approved, or why not
  decidedByUserId  String? // scalar → users.id
  decidedAt        DateTime?
  completedAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  hallTicket     HallTicket     @relation(fields: [hallTicketId], references: [id])
  studentProfile StudentProfile @relation(fields: [studentProfileId], references: [id])

  @@index([hallTicketId])
  @@index([studentProfileId])
  @@index([status])
  @@map("hall_ticket_requests")
}

model Evaluation {
  id                String   @id @default(cuid())
  examSlotId        String
  subjectOfferingId String // the offering whose papers are evaluated
  totalPapers       Int      @default(0)
  completedPapers   Int      @default(0)
  inProgressPapers  Int      @default(0)
  evaluatorUserId   String? // scalar → users.id
  status            String   @default("PENDING") // PENDING | IN_PROGRESS | COMPLETED
  moderationStatus  String   @default("NOT_REQUESTED") // NOT_REQUESTED | PENDING | APPROVED | FLAGGED
  moderatedByUserId String? // scalar → users.id
  moderatedAt       DateTime?
  moderationNote    String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  examSlot          ExamSlot          @relation(fields: [examSlotId], references: [id])
  subjectOffering   CourseOffering    @relation("SlotOffering", fields: [subjectOfferingId], references: [id])
  papers            EvaluationPaper[]

  @@unique([examSlotId, subjectOfferingId])
  @@index([examSlotId])
  @@index([subjectOfferingId])
  @@map("evaluations")
}

model EvaluationPaper {
  id               String    @id @default(cuid())
  evaluationId     String
  studentProfileId String
  evaluatorUserId  String? // scalar → users.id
  marksEntered     Int?
  internalMarks    Int? // marksEntered = internalMarks + externalMarks (policy: 0..40 / 0..60)
  externalMarks    Int?
  scriptStatus     String    @default("NOT_RECEIVED") // NOT_RECEIVED | RECEIVED | VERIFIED
  status           String    @default("PENDING") // PENDING | EVALUATING | DONE
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  evaluation     Evaluation     @relation(fields: [evaluationId], references: [id])
  studentProfile StudentProfile @relation(fields: [studentProfileId], references: [id])

  @@unique([evaluationId, studentProfileId])
  @@index([evaluationId])
  @@index([studentProfileId])
  @@map("evaluation_papers")
}

model Result {
  id               String    @id @default(cuid())
  examSlotId       String
  studentProfileId String
  marksObtained    Int
  maxMarks         Int
  grade            String
  isPass           Boolean   @default(false)
  publishedAt      DateTime?
  publishedByUserId String? // scalar → users.id
  // X-06 workflow: DRAFT (consolidated) → VERIFIED → APPROVED → PUBLISHED.
  // Every move is stamped; grade/isPass are DERIVED at consolidation from the
  // scale in result.rules.ts, never supplied by a client.
  status            String    @default("DRAFT") // DRAFT | VERIFIED | APPROVED | PUBLISHED
  verifiedByUserId  String? // scalar → users.id
  verifiedAt        DateTime?
  approvedByUserId  String? // scalar → users.id
  approvedAt        DateTime?
  revision          Int       @default(0) // bumped when a re-evaluation revises the marks
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  examSlot       ExamSlot             @relation(fields: [examSlotId], references: [id])
  studentProfile StudentProfile       @relation(fields: [studentProfileId], references: [id])
  reEvaluations  ReEvaluationRequest[]

  @@unique([examSlotId, studentProfileId])
  @@index([examSlotId])
  @@index([studentProfileId])
  @@map("results")
}

model ReEvaluationRequest {
  id               String    @id @default(cuid())
  resultId         String
  studentProfileId String
  reason           String
  status           String    @default("REQUESTED") // REQUESTED | APPROVED | COMPLETED | REJECTED
  decidedByUserId  String? // scalar → users.id
  decidedAt        DateTime?
  revisedMarks     Int? // COMPLETED with a change: the new marksObtained (0..result.maxMarks)
  note             String? // why the request was completed/rejected
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  result         Result         @relation(fields: [resultId], references: [id])
  studentProfile StudentProfile @relation(fields: [studentProfileId], references: [id])

  @@index([resultId])
  @@index([studentProfileId])
  @@map("re_evaluation_requests")
}

model CheatingCase {
  id               String    @id @default(cuid())
  examSlotId       String
  studentProfileId String
  issue            String
  riskLevel        String // HIGH | MEDIUM | LOW
  evidenceJson     String?
  source           String // AI | INVIGILATOR
  status           String    @default("UNDER_REVIEW") // UNDER_REVIEW | CONFIRMED | DISMISSED | ESCALATED
  reviewedByUserId String? // scalar → users.id
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  // ── The incident, as reported ──
  //
  // `issue` is the ONE-LINE label the queue shows ("Frequent gaze deviation detected"). `description`
  // is the incident narrative the reporter actually wrote. They are different facts and the queue
  // needs the first while the committee needs the second, so they are two columns rather than one
  // field used for both.
  description      String?

  /// WHERE the incident happened, and WHO was watching. Both are DERIVED from
  /// `ExamRoomAllocation` — the room allocation for the slot already carries the room and the
  /// invigilator — but they are SNAPSHOTTED here, because a case is a historical document: the room
  /// roster for an exam in March is not the room roster today, and a case decided in June must still
  /// say which room it happened in and who was on duty.
  roomId           String? // scalar → room master
  invigilatorUserId String? // scalar → users.id
  reportedByUserId  String? // scalar → users.id — who raised it

  /// WHAT KIND of malpractice this is. `riskLevel` is how SEVERE it is; `classification` is what it
  /// IS. They are independent: a dismissed case can be HIGH risk, and a confirmed case can be LOW
  /// risk. Collapsing them into one field is why "confirmed" and "high risk" get used
  /// interchangeably on a screen.
  classification   String? // IMPERSONATION | HIDDEN_DEVICE | COPY_PASTE | ANSWER_SIMILARITY | TIMING_PATTERN | LOOKING_AROUND | POSSESSION | OTHER

  /// The student's own account of what happened. It is recorded SEPARATELY from the incident
  /// description because they are two different accounts of the same event, and a committee that
  /// cannot see both cannot judge.
  studentStatement String?
  statementAt      DateTime?
  statementByUserId String? // scalar → users.id

  /// The committee's finding. `committeeUserIds` is a JSON list of user ids rather than a join table:
  /// a committee is a small, ad-hoc group attached to ONE case, and nothing in the platform queries
  /// "every case this person sat on" — so a table would be a relationship nothing ever traverses.
  committeeUserIds String? // JSON array of user ids
  reviewNote       String?
  reviewedAt       DateTime?

  /// The outcome. `penalty` is the consequence, and it is a separate field from `status` because
  /// "confirmed" says what was decided and "penalty" says what it costs.
  decisionNote     String?
  penalty          String? // WARNING | REPEAT_OFFENDER | SUSPENSION | CANCEL_EXAM | EXCLUSION | NONE
  penaltyDetail    String?
  decidedAt        DateTime?
  decidedByUserId  String? // scalar → users.id

  /// The student has been told. A case that was decided and never communicated is a case the
  /// student cannot appeal, so the fact of telling them is recorded rather than assumed.
  notifiedStudentAt DateTime?

  examSlot       ExamSlot       @relation(fields: [examSlotId], references: [id])
  studentProfile StudentProfile @relation(fields: [studentProfileId], references: [id])

  /// The timeline and the evidence. Both are collections OF a case, so they cascade with it.
  events   CheatingCaseEvent[]
  evidence CheatingCaseEvidence[]

  @@index([examSlotId])
  @@index([studentProfileId])
  @@index([status])
  @@index([riskLevel])
  @@index([classification])
  @@index([reportedByUserId])
  @@map("cheating_cases")
}

/// Every state change on a case, in order.
///
/// A case moves through several hands — reported, reviewed by the committee, a statement taken, a
/// decision made, the student told — and each of those is something a person did, at a time, on
/// purpose. A single `status` column cannot say WHEN or BY WHOM, and a case file that cannot say
/// who reviewed it is not reviewable.
model CheatingCaseEvent {
  id           String   @id @default(cuid())
  cheatingCaseId String
  /// REPORTED | CLASSIFIED | STATEMENT_TAKEN | COMMITTEE_REVIEW | DECIDED | ESCALATED | REOPENED |
  /// NOTIFIED | EVIDENCE_ADDED | NOTE_ADDED
  type         String
  /// The user who did it. NULL for a derived event (a case ageing into escalation) — recorded, but
  /// not attributable to a person.
  actorUserId  String?
  note         String?
  /// What changed, as JSON. `{"status":"CONFIRMED","penalty":"SUSPENSION"}` and so on, so the timeline
  /// can show the BEFORE and the AFTER without every event type needing its own columns.
  detailJson   String?
  createdAt    DateTime @default(now())

  cheatingCase CheatingCase @relation(fields: [cheatingCaseId], references: [id], onDelete: Cascade)

  @@index([cheatingCaseId, createdAt])
  @@map("cheating_case_events")
}

/// A document attached to a case as evidence.
///
/// The FILE itself lives in the platform's `File` table — that is where every uploaded document in
/// this app already lives, with its mime type, size and storage key. This table records what the
/// file IS in the context of a case: which case, which kind of evidence, who attached it, and when.
model CheatingCaseEvidence {
  id           String   @id @default(cuid())
  cheatingCaseId String
  fileId       String
  /// SCREENSHOT | SCRIPT | DEVICE_PHOTO | REPORT | STATEMENT_DOCUMENT | OTHER
  kind         String   @default("OTHER")
  note         String?
  uploadedByUserId String?
  createdAt    DateTime @default(now())

  cheatingCase CheatingCase @relation(fields: [cheatingCaseId], references: [id], onDelete: Cascade)
  file         File        @relation(fields: [fileId], references: [id])

  @@index([cheatingCaseId])
  @@map("cheating_case_evidence")
}
