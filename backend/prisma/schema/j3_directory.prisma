// Domain J3 — Alumni directory: skills, career journey, privacy, connections.
// Docs: 12-alumni-relations.md §3.2 · §5 (networking, skills, career, privacy)
//
// ── Why these are tables and not columns ───────────────────────
//
// · AlumniSkill is NORMALISED rather than a JSON array on the profile because
//   the directory has to answer "who knows Kubernetes" and "who can mentor a
//   final-year student into platform engineering" in SQL. A JSON column forces
//   both into a JS scan, cannot be indexed, and cannot be filtered or sorted
//   by the database. The uniqueness on (profileId, skill) also stops the same
//   skill being listed twice with different capitalisation.
//
// · AlumniCareerEntry exists because "career journey" is inherently a
//   TIMELINE — a sequence of roles over time, with gaps and overlaps — not a
//   column. Storing only the current role (AlumniProfile.currentRole) loses the
//   promotions and lateral moves that make a career worth reading. `toMonth`
//   is NULL for the current role: "present" is an absence, not a date.
//
// · AlumniPrivacySettings is a 1:1 companion to the profile rather than more
//   boolean columns on it, so "does this alumnus want to be found" is a single
//   readable object and the API has ONE place to apply redaction. Default is
//   CLOSED for contact details: an email address or phone number is not
//   published because it is technically stored.
//
// · AlumniConnection is a single table with a status column rather than a
//   "friendships" table, because a request has a lifecycle (PENDING →
//   ACCEPTED/DECLINED) that is itself meaningful to the UI: the recipient has
//   an inbox to act on, and the requester needs to see "pending" vs "connected".
//   The unique (requester, recipient) pair makes a duplicate request
//   impossible; the reverse direction is a separate row, which is what lets an
//   accepted pair be found from either side.

model AlumniSkill {
  id               String   @id @default(cuid())
  alumniProfileId  String
  skill            String
  level            String   @default("INTERMEDIATE") // BEGINNER | INTERMEDIATE | ADVANCED | EXPERT
  yearsExperience  Int?     // years claimed, for "10+ yrs in X" badges
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  profile AlumniProfile @relation(fields: [alumniProfileId], references: [id], onDelete: Cascade)

  @@unique([alumniProfileId, skill])
  @@index([skill])
  @@index([level])
  @@map("alumni_skills")
}

model AlumniCareerEntry {
  id               String    @id @default(cuid())
  alumniProfileId  String
  title            String
  companyId        String?   // FK → companies (Domain D)
  // Denormalised so a career row is still readable when the employer is not in
  // the companies table (a startup, a self-employed stint, an overseas employer
  // nobody has registered). companyId is the linkable one; this is the label.
  employerLabel    String?
  location         String?
  fromMonth        DateTime
  toMonth          DateTime? // NULL = current role
  isHighlight      Boolean   @default(false)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  profile AlumniProfile @relation(fields: [alumniProfileId], references: [id], onDelete: Cascade)
  // Optional link to the registered employer. NULL is normal: startups,
  // self-employment and overseas employers are not in the companies table, and
  // `employerLabel` carries the name in that case.
  company Company?       @relation(fields: [companyId], references: [id], onDelete: SetNull)

  @@index([alumniProfileId, fromMonth])
  @@index([companyId])
  @@map("alumni_career_entries")
}

// An achievement is something a graduate declares about themselves that is NOT a job:
// an award, a certification, a publication, a talk they gave, or volunteer work.
//
// WHY VERIFICATION EXISTS
// -----------------------
// Self-declared alone means every card can claim anything, and a directory of
// unverifiable badges is worth less than one without. So a graduate writes their own
// entries and the Alumni Relations Office verifies them, which sets `isVerified` plus
// the stamp below. The UI shows unverified entries differently from verified ones
// rather than hiding them — an unverified claim is still true as a claim, it is just
// not endorsed.
//
// `verifiedByUserId` is a SCALAR, not a relation. That matches every other actor
// stamp in this schema (Broadcast.senderUserId, Announcement.authorUserId,
// AuditLog.actorUserId) and it means adding achievements does not touch the shared
// `User` model, which five other modules also point at.
model AlumniAchievement {
  id               String   @id @default(cuid())
  alumniProfileId  String
  title            String   // "ACM Distinguished Speaker", "Kotlin Certified"
  description      String?
  // AWARD | CERTIFICATION | PUBLICATION | TALK | VOLUNTEER
  kind             String   @default("AWARD")
  // Who gave it. Free text, not an FK: awards come from bodies this schema has never
  // heard of, and inventing an "issuing organisation" table to hold four rows would
  // be worse than the string.
  issuer           String?
  year             Int?
  url              String?
  isVerified       Boolean  @default(false)
  verifiedByUserId String?  // scalar → users.id
  verifiedAt       DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  profile AlumniProfile @relation(fields: [alumniProfileId], references: [id], onDelete: Cascade)

  // Unique on (profile, title, year) rather than title alone: the same talk can be
  // given in 2023 and again in 2024, and two graduates obviously share titles.
  @@unique([alumniProfileId, title, year])
  @@index([alumniProfileId, kind])
  @@map("alumni_achievements")
}

model AlumniPrivacySettings {
  id               String   @id @default(cuid())
  alumniProfileId  String   @unique
  // Contact details are OFF by default. Being an alumnus is not consent to
  // publish an email address and phone number to every logged-in user.
  showEmail        Boolean  @default(false)
  showPhone        Boolean  @default(false)
  showLocation     Boolean  @default(true)
  showCareer       Boolean  @default(true)
  showSkills       Boolean  @default(true)
  // Professional links (LinkedIn/GitHub/website), same treatment as skills and
  // career: ON by default, because these are what make a directory card worth
  // clicking, and muteable because a personal URL is a way to be contacted outside
  // the platform. Added alongside them rather than folded into one of them so a
  // graduate can hide their employer history but keep their GitHub.
  showLinks        Boolean  @default(true)
  // discoverable = may appear in directory search AND in match suggestions.
  // false hides the profile from browse but leaves a direct link working, so an
  // alumnus who unlists themselves is still reachable by someone who has their
  // id — hiding from search and blocking contact are different intentions.
  discoverable     Boolean  @default(true)
  // ANYONE → any signed-in user | CONNECTIONS → accepted connections only |
  // OFFICE → the Alumni Relations office only.
  visibleTo        String   @default("CONNECTIONS")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  profile AlumniProfile @relation(fields: [alumniProfileId], references: [id], onDelete: Cascade)

  @@map("alumni_privacy_settings")
}

model AlumniConnection {
  id                String    @id @default(cuid())
  institutionId     String
  requesterUserId   String    // scalar → users.id
  recipientUserId   String    // scalar → users.id
  status            String    @default("PENDING") // PENDING | ACCEPTED | DECLINED | CANCELLED
  message           String?
  respondedAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  requester   User @relation("AlumniConnectionRequester", fields: [requesterUserId], references: [id])
  recipient   User @relation("AlumniConnectionRecipient", fields: [recipientUserId], references: [id])

  // One request per ordered pair. The reverse direction (A→B then B→A) is a
  // different row, which the service resolves into a single connection when
  // both sides have asked — so two people who want each other end up connected
  // instead of in a deadlock of two pending requests.
  @@unique([requesterUserId, recipientUserId])
  @@index([recipientUserId, status])
  @@index([requesterUserId, status])
  @@index([institutionId, status])
  @@map("alumni_connections")
}