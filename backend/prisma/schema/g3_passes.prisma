// Domain G3 — Gate passes, complaints, visitors.
// Docs: 08-hostel.md §3.5–3.7 · 05-state-machines.md
// decidedByUserId / assignedToUserId scalar actor-stamps.

// A student's request to leave the hostel, and the warden's decision on it.
//
// REQUEST vs TRAVEL ARE TWO DIFFERENT CLOCKS
// ------------------------------------------
// `outAt` / `expectedInAt` are what the student PLANNED. `actualOutAt` / `actualInAt` are what
// the gate actually recorded. The gap between them is the whole point of the feature: it is
// what "left on time" and "came back on time" are measured against.
//
// Only `actualInAt` existed before, so "entry/exit history" had half an entry — a return with
// no matching departure, and no way to tell a student who left from one who never did.
//
// WHY `isEmergency` DOES NOT BYPASS APPROVAL
// ------------------------------------------
// It is a PRIORITY flag: it sorts to the top of the warden's queue and is filterable. Nothing
// here auto-approves anything. A student who could self-authorise a gate exit by ticking a
// checkbox would not be a gate pass system, and a genuine 2am emergency is exactly the case
// where a phone call to the warden is the right control anyway.
//
// WHY `verifiedAt` IS SEPARATE FROM `decidedByUserId`
// ---------------------------------------------------
// Approving a pass records who decided. It does NOT record that anyone looked at the student's
// face. Those are different acts, and the useful case is the second one being ABSENT: an
// approved pass with `verifiedAt = null` is one a warden approved on the basis of a name on a
// slip. Making it an explicit, default-false claim is what gives the field meaning — storing
// the same user id twice would tell nobody anything the decision row does not already say.
model GatePass {
  id               String    @id @default(cuid())
  studentProfileId String
  reason           String
  // Where they are going. Distinct from `reason`: "medical" is why, "Rajiv Gandhi Hospital,
  // Chennai" is where. A warden deciding whether to approve a night out needs the where.
  destination      String?
  // PLANNED departure and return, chosen by the student when requesting.
  outAt            DateTime
  expectedInAt     DateTime
  // ACTUAL, stamped by the warden at the gate.
  actualOutAt      DateTime?
  actualInAt       DateTime?
  status           String    @default("PENDING") // PENDING | APPROVED | REJECTED | CANCELLED
  isEmergency      Boolean   @default(false) // priority flag; never auto-approved
  verifiedAt       DateTime? // warden confirms the student's ID; null = approved without it
  decisionNote     String? // why a request was rejected — the student is told this
  decidedByUserId  String? // scalar → users.id
  // WHEN the decision was made. Not derivable from anything else already here: `verifiedAt` is
  // only set when the warden ALSO ticked the ID box, and `updatedAt` moves again on every
  // later gate stamp (exit, return). Without this, the timeline has to date an approval by the
  // request time, which quietly erases how long the student waited. Mirrors `cancelledAt`.
  decidedAt        DateTime?
  cancelledAt      DateTime? // set when the STUDENT withdraws a pending request
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  studentProfile StudentProfile @relation(fields: [studentProfileId], references: [id])

  @@index([studentProfileId])
  @@index([status])
  // The warden's inbox reads "pending, oldest departure first" and "overdue returns", so the
  // composite matters more than either column alone.
  @@index([status, outAt])
  @@index([status, expectedInAt])
  @@map("gate_passes")
}

model HostelComplaint {
  id               String    @id @default(cuid())
  studentProfileId String
  category         String // PLUMBING | ELECTRICAL | NETWORK | MAINTENANCE
  description      String
  severity         String // LOW | MEDIUM | HIGH
  status           String    @default("OPEN") // OPEN | ASSIGNED | RESOLVED
  assignedToUserId String? // scalar → users.id
  resolvedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  studentProfile StudentProfile @relation(fields: [studentProfileId], references: [id])

  @@index([studentProfileId])
  @@index([status])
  @@map("hostel_complaints")
}

// WHY EVERY ADDED FIELD IS OPTIONAL
// -------------------------------
// This model predates the visitor workflow and already holds rows, so every column added for the
// workflow is NULLABLE. A visitor recorded before the feature existed has no purpose, no planned
// window and no identity proof, and it must stay readable and checkable-out rather than becoming
// unloadable. The code treats a missing field as "not recorded", never as an error - see
// `hostel-visitors.rules.ts`, where an absent window suppresses the hours alert instead of
// raising one.
//
// `phone` IS THE IDENTITY KEY. A name is not an identity: "Suresh Kumar" matches a dozen people,
// and a barred list keyed on a name would bar the wrong visitor. Match prefers an exact phone
// match and only falls back to a normalised name when the institution recorded no phone at all.
// `normalisedName` is stored (not computed at query time) so the fallback is indexable.
model Visitor {
  id                      String    @id @default(cuid())
  institutionId           String
  name                    String
  visitingStudentProfileId String
  relation                String

  // ---- Identity, beyond a name -------------------------------------------------
  phone                   String?
  phoneDigits             String?   // digits only, so "(98450) 12345" and "9845012345" match
  idType                  String?   // AADHAAR | PASSPORT | DRIVING_LICENCE | STUDENT_ID | OTHER
  idNumber                String?

  // ---- Purpose -----------------------------------------------------------------
  purpose                 String?

  // ---- PLANNED window, chosen by the resident when authorising ------------------
  // Distinct from the ACTUAL stamps below, exactly as with a gate pass. `expectedInAt` and
  // `expectedOutAt` drive "who should be here" and "who is overstaying"; `checkInAt` and
  // `checkOutAt` are what actually happened at the gate.
  expectedInAt            DateTime?
  expectedOutAt           DateTime?

  // ---- ACTUAL stamps at the gate -----------------------------------------------
  // `checkInAt` is nullable now (it used to default to now), because a RESIDENT-AUTHORISED
  // visitor has been promised for 6pm and has not arrived. Defaulting it to creation time
  // would make every approved-but-absent visitor look like they were already on campus.
  checkInAt               DateTime?
  checkOutAt              DateTime?

  // PENDING     resident authorised, warden has not confirmed
  // APPROVED    warden confirmed, not yet on campus
  // IN          on campus
  // OUT         left
  // REJECTED    warden refused
  // CANCELLED   resident withdrew the authorisation
  // NO_SHOW     the window passed and they never arrived
  status                  String    @default("PENDING")

  // ---- Workflow stamps. Mirrors GatePass's decidedBy / decidedAt / decisionNote ----
  requestedByUserId       String?   // the RESIDENT who authorised, distinct from the warden
  approvedByUserId        String?
  approvedAt              DateTime?
  decisionNote            String?

  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  visitingStudent StudentProfile @relation(fields: [visitingStudentProfileId], references: [id])

  @@index([visitingStudentProfileId])
  @@index([status])
  // The warden's inbox reads "awaiting confirmation, soonest arrival first" and "still on
  // campus past their expected departure"; the composite serves both better than status alone.
  @@index([status, expectedInAt])
  @@index([status, expectedOutAt])
  // Backs the barred-list lookup and the repeat-frequency count.
  @@index([institutionId, phoneDigits])
  @@index([visitingStudentProfileId, checkInAt])
  @@map("visitors")
}

// A person this institution does not admit, whatever the resident says.
//
// Deliberately NOT a flag on Visitor. A bar has to outlive the visit that provoked it: a resident
// can withdraw an authorisation and the visitor row disappears, but "this person is not admitted"
// is a standing fact about the institution, not a property of one booking. Keyed on
// institutionId so two colleges in the same deployment have independent lists.
//
// `phoneDigits` is what a check matches on. `normalisedName` exists for the fallback when no
// phone was ever recorded, and is stored rather than computed so the lookup stays indexable.
model BarredVisitor {
  id              String   @id @default(cuid())
  institutionId   String
  name            String
  phone           String?
  phoneDigits     String?
  normalisedName  String
  reason          String
  barredByUserId  String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([institutionId, phoneDigits])
  @@index([institutionId, normalisedName])
  @@map("barred_visitors")
}
