// Domain H3 — Live tracking + maintenance. Docs: 09-transport.md §3.5–3.6.
// bus_positions: one row per vehicle (uq vehicleId) — upsert on every GPS ping,
// no WS infra yet. currentStopId optional FK to route_stops.

model BusPosition {
  id             String    @id @default(cuid())
  vehicleId      String    @unique // latest position per vehicle
  routeId        String
  currentStopId  String?
  speedKmh       Int       @default(0)
  lat            Float
  lng            Float
  etaMin         Int?
  status         String    @default("ON_TIME") // ON_TIME | DELAYED
  pingedAt       DateTime  @default(now())
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  vehicle     Vehicle    @relation(fields: [vehicleId], references: [id])
  route       Route      @relation(fields: [routeId], references: [id])
  currentStop RouteStop? @relation("CurrentStop", fields: [currentStopId], references: [id])

  @@index([routeId])
  @@map("bus_positions")
}

model ServiceRecord {
  id          String    @id @default(cuid())
  vehicleId   String
  type        String // PERIODIC | REPAIR | INSPECTION
  costMinor   Int       @default(0)
  serviceDate DateTime
  status      String    @default("SCHEDULED") // SCHEDULED | IN_PROGRESS | COMPLETED
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  vehicle Vehicle @relation(fields: [vehicleId], references: [id])

  @@index([vehicleId])
  @@map("service_records")
}

model FuelLog {
  id          String   @id @default(cuid())
  vehicleId   String
  litres      Float
  amountMinor Int
  filledAt    DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  vehicle Vehicle @relation(fields: [vehicleId], references: [id])

  @@index([vehicleId])
  @@map("fuel_logs")
}
