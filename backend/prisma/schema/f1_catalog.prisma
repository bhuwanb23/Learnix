// Domain F1 — Catalog: physical books + digital resources + procurements.
// Docs: 07-library-staff.md §3.2 · §3.5 · §3.6 · 03-admin.md §3.12
// availableCopies is denormalized — service layer keeps it in sync with issues.
// Access grants point at programs/batches (scalars until Domain B FK flip —
// programId is a real FK already; batchId too). requestId on procurements is
// optional link to book_requests.

model Book {
  id              String   @id @default(cuid())
  institutionId   String
  title           String
  author          String?
  isbn            String?
  category        String? // CS | MECH | FICTION | REFERENCE …
  totalCopies     Int      @default(1)
  availableCopies Int      @default(1) // denorm — never exceeds totalCopies
  rackLocation    String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  issues BookIssue[]

  @@index([institutionId])
  @@index([title])
  @@map("books")
}

model DigitalResource {
  id            String   @id @default(cuid())
  institutionId String
  title         String
  type          String // PDF | EBOOK | JOURNAL
  subject       String?
  license       String?
  externalUrl   String?
  description   String?
  publisher     String?
  status        String   @default("ACTIVE") // ACTIVE | ARCHIVED
  accessCount   Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  grants DigitalAccessGrant[]
  accessLogs DigitalResourceAccess[]

  @@index([institutionId])
  @@index([type])
  @@map("digital_resources")
}

// Per-open access log — the aggregate `accessCount` on DigitalResource is the
// denormalized sum of these rows, kept in sync by the service layer.
model DigitalResourceAccess {
  id                String   @id @default(cuid())
  resourceId        String
  studentProfileId  String?
  accessType        String   @default("OPEN") // OPEN | DOWNLOAD | VIEW
  createdAt         DateTime @default(now())

  resource DigitalResource @relation(fields: [resourceId], references: [id])

  @@index([resourceId])
  @@index([createdAt])
  @@map("digital_resource_accesses")
}

model DigitalAccessGrant {
  id         String   @id @default(cuid())
  resourceId String
  programId  String? // grant to whole program
  batchId    String? // or narrow to a batch
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  resource DigitalResource @relation(fields: [resourceId], references: [id])
  program  Program?        @relation(fields: [programId], references: [id])
  batch    Batch?          @relation(fields: [batchId], references: [id])

  @@index([resourceId])
  @@map("digital_access_grants")
}

// A purchase raised once a student request is approved. Advancing it to RECEIVED
// creates the catalog `Book` and stores its id in `bookId`, which is what closes
// the loop: request → purchase → shelf, all traceable.
model BookProcurement {
  id            String   @id @default(cuid())
  requestId     String? // scalar → book_requests.id (same domain)
  institutionId String
  title         String
  author        String?
  copies        Int      @default(1)
  costMinor     Int      @default(0) // integer paise (ADR-04); 0 until a cost is recorded
  status        String   @default("REQUESTED") // REQUESTED | ORDERED | RECEIVED | CANCELLED
  category      String? // shelf category, decided at receipt
  rackLocation  String? // where it was shelved, decided at receipt
  orderedAt     DateTime?
  receivedAt    DateTime?
  bookId        String? // scalar → books.id, set when RECEIVED creates the catalog entry
  note          String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([institutionId])
  @@index([status])
  @@map("book_procurements")
}
