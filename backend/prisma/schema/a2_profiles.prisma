// Domain A2 — Role profiles: student, staff, alumni
// One profile row per user per kind. programId/batchId/departmentId/companyId/
// chapterId become FKs when their owning domains (B/D/J) land — plain scalars now.
// institutionId is denormalized here solely to power per-institution uniques.

model StudentProfile {
  id              String    @id @default(cuid())
  userId          String    @unique
  institutionId   String
  rollNo          String
  programId       String? // FK → programs (Domain B)
  batchId         String? // FK → batches (Domain B)
  section         String?
  currentSemester Int?
  admissionDate   DateTime?
  status          String    @default("ACTIVE") // ACTIVE | ALUMNUS | DROPPED
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id])

  enrollments       Enrollment[]
  attendanceRecords AttendanceRecord[]
  submissions       Submission[]
  quizAttempts      QuizAttempt[]
  hallTickets       HallTicket[]
  evaluationPapers  EvaluationPaper[]
  results           Result[]
  reEvaluations     ReEvaluationRequest[]
  hallTicketRequests HallTicketRequest[]
  cheatingCases     CheatingCase[]
  jobApplications   JobApplication[]
  placementEligibility PlacementEligibility?
  driveRegistrations   DriveRegistration[]
  feeDues           FeeDue[]
  payments          Payment[]
  transportFeeDues  TransportFeeDue[]
  scholarshipApplications ScholarshipApplication[]
  bookIssues        BookIssue[]
  bookRequests      BookRequest[]
  hostelAllocations HostelAllocation[]
  mealAttendances   MealAttendance[]
  messFeedback      MessFeedback[]
  gatePasses        GatePass[]
  hostelComplaints  HostelComplaint[]
  visitorsHosted    Visitor[]
  routeEnrollments  RouteEnrollment[]
  eventVolunteering EventVolunteer[]
  teamMemberships   TeamMember[]
  equipmentIssues   EquipmentIssue[]
mentorshipsAsMentee MentorshipPair[]
  mentorshipRequests  MentorshipRequest[]

  @@unique([institutionId, rollNo])
  @@index([institutionId])
  @@map("student_profiles")
}

model StaffProfile {
  id               String    @id @default(cuid())
  userId           String    @unique
  institutionId    String
  employeeNo       String
  designation      String?
  departmentId     String? // FK → departments (Domain B)
  joiningDate      DateTime?
  maxWorkloadHours Int       @default(18)
  status           String    @default("ACTIVE")
  // Payroll inputs (F-06). monthlyGrossMinor is the MONTHLY gross in paise —
  // 0 means "not on payroll", and runPayroll excludes rather than guesses.
  monthlyGrossMinor Int      @default(0)
  bankAccountLast4  String?
  salaryEffectiveFrom DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@unique([institutionId, employeeNo])
  @@index([institutionId])
  @@map("staff_profiles")
}

model AlumniProfile {
  id               String   @id @default(cuid())
  userId           String   @unique
  institutionId    String
  batchId          String? // FK → batches (Domain B)
  graduationYear   Int?
  companyId        String? // FK → companies (Domain D)
  currentRole      String?
  location         String?
  chapterId        String? // FK → alumni_chapters (Domain J, landed)
  engagementStatus String   @default("ACTIVE") // ACTIVE | INACTIVE | LOST
  // Directory card content. `headline` is the one-line "what I do now"
  // (e.g. "Staff Engineer · distributed systems"); `bio` is the longer
  // free-text an alumnus writes about themselves. Both are OPTIONAL and both
  // are gated by privacy settings, not shown raw.
headline         String?
  bio              String?
  // Professional links. Three columns rather than a JSON blob so each one can be
  // validated for shape (a LinkedIn URL is not a website URL), rendered with its own
  // affordance, and gated independently if that ever becomes necessary.
  // All three are OPTIONAL and, like the rest of the card, subject to privacy —
  // `AlumniPrivacySettings.showLinks`. Gated by the same rule as skills and career
  // rather than being always-public, because a personal URL is a contact surface.
  linkedinUrl      String?
  githubUrl        String?
  websiteUrl       String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user    User           @relation(fields: [userId], references: [id])
  chapter AlumniChapter? @relation(fields: [chapterId], references: [id])
  // batchId/companyId were plain scalars while Domains B and D were still in
  // flight; both have landed, so they are real relations now. Without them the
  // directory cannot filter by department (profile → batch → program →
  // department) or show an employer name instead of a raw id.
  // SetNull: retiring a Company row must not delete the alumni who worked there.
  batch   Batch?         @relation(fields: [batchId], references: [id], onDelete: SetNull)
  company Company?       @relation(fields: [companyId], references: [id], onDelete: SetNull)

  skills       AlumniSkill[]
  career       AlumniCareerEntry[]
  achievements AlumniAchievement[]
  privacy      AlumniPrivacySettings?

  // The mentee half of mentorship is polymorphic: an alumnus can mentor a
  // STUDENT (via StudentProfile.mentorshipsAsMentee) or another alumnus (here).
  mentorshipsAsMentee MentorshipPair[]     @relation("MenteeAlumniProfile")
  mentorshipRequests  MentorshipRequest[]  @relation("RequestMenteeAlumniProfile")

  @@index([institutionId])
  @@index([graduationYear])
  @@index([companyId])
  @@index([location])
  @@map("alumni_profiles")
}
