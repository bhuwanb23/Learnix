// Domain A4 — Auth token tables (ADR-07)
// refresh_tokens: rotation + reuse detection (replacedById chain).
// password_resets: one-time hashed tokens.

model RefreshToken {
  id           String    @id @default(cuid())
  userId       String
  tokenHash    String    @unique // sha256 of the raw token — raw never stored
  expiresAt    DateTime
  revokedAt    DateTime?
  replacedById String? // id of the token that replaced this one (rotation chain)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("refresh_tokens")
}

model PasswordReset {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique // one-time hashed token
  expiresAt  DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("password_resets")
}
