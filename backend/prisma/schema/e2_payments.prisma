// Domain E2 — THE unified money-in table + receipts + per-category link rows.
// Docs: 06-accounts-finance.md §3.2 · write-throughs from 07/08/09/12
// Every rupee entering the institution becomes a payments row; the category +
// optional link rows (donation_payments, transport_fee_dues, hostel_rent_dues,
// fine_payments) give each source its detail. payerUserId / recordedByUserId
// are scalar actor-stamps. gatewayRef reserved for the payment-gateway phase.

model Payment {
  id               String    @id @default(cuid())
  institutionId    String
  payerUserId      String? // scalar → users.id (who paid — may be a parent/donor)
  studentProfileId String? // whose account it credits (donations may be null-student)
  category         String // TUITION | HOSTEL_RENT | MESS | TRANSPORT | FINE | DONATION | MISC
  referenceNo      String
  amountMinor      Int
  method           String // UPI | NET_BANKING | CARD | CASH
  status           String    @default("PENDING") // CLEARED | PARTIAL | PENDING | FAILED
  paidAt           DateTime?
  recordedByUserId String? // scalar → users.id (staff who recorded cash/cheque)
  gatewayRef       String?
  // Reversal stamp. A reversed payment keeps its row (the ledger must not lose
  // history) but stops counting toward collections and is excluded from dues.
  reversedAt      DateTime?
  reversalReason  String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  studentProfile StudentProfile? @relation(fields: [studentProfileId], references: [id])
  receipt        Receipt?
  donationLink   DonationPayment?
  transportDue   TransportFeeDue?
  hostelRentDue  HostelRentDue?
  fineLink       FinePayment?
  allocations    PaymentAllocation[]

  @@unique([institutionId, referenceNo])
  @@index([institutionId])
  @@index([category])
  @@index([studentProfileId])
  @@map("payments")
}

model Receipt {
  id        String   @id @default(cuid())
  paymentId String   @unique
  receiptNo String // unique per institution — service-layer format RCP-2026-0001
  issuedAt  DateTime @default(now())
  // Set when the payment is reversed: the receipt existed, but it no longer
  // stands as proof of a live collection.
  voidedAt  DateTime?
  voidReason String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payment Payment @relation(fields: [paymentId], references: [id])

  @@index([paymentId])
  @@map("receipts")
}

// DONATION link — FK to donations (Domain J, landed)
model DonationPayment {
  id         String   @id @default(cuid())
  paymentId  String   @unique
  donationId String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  payment  Payment  @relation(fields: [paymentId], references: [id])
  donation Donation @relation(fields: [donationId], references: [id])

  @@index([paymentId])
  @@map("donation_payments")
}

// TRANSPORT dues — per student per academic year
model TransportFeeDue {
  id               String    @id @default(cuid())
  paymentId        String?   @unique
  studentProfileId String
  academicYearId   String
  amountMinor      Int
  status           String    @default("UNPAID") // UNPAID | PARTIAL | PAID
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  payment        Payment?       @relation(fields: [paymentId], references: [id])
  studentProfile StudentProfile @relation(fields: [studentProfileId], references: [id])
  academicYear   AcademicYear   @relation(fields: [academicYearId], references: [id])

  @@unique([studentProfileId, academicYearId])
  @@index([studentProfileId])
  @@map("transport_fee_dues")
}

// HOSTEL rent dues — per allocation per month (FK to Domain G, landed)
model HostelRentDue {
  id           String   @id @default(cuid())
  paymentId    String?  @unique
  allocationId String
  month        String // "2026-08"
  amountMinor  Int
  status       String   @default("UNPAID") // UNPAID | PARTIAL | PAID
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  payment    Payment?         @relation(fields: [paymentId], references: [id])
  allocation HostelAllocation @relation(fields: [allocationId], references: [id])

  @@unique([allocationId, month])
  @@map("hostel_rent_dues")
}

// FINE link — FK to book_issues (Domain F, landed)
model FinePayment {
  id          String   @id @default(cuid())
  paymentId   String   @unique
  bookIssueId String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  payment   Payment   @relation(fields: [paymentId], references: [id])
  bookIssue BookIssue @relation(fields: [bookIssueId], references: [id])

  @@index([paymentId])
  @@map("fine_payments")
}

// ALLOCATION link — which fee_dues rows a payment settled, and how much went to
// each. One payment can clear several dues (a student paying a semester's bill
// in one go), which is exactly why the due cannot hold a single paymentId.
// This is what lets a reversal put the money back where it came from.
model PaymentAllocation {
  id        String   @id @default(cuid())
  paymentId String
  dueId     String
  amountMinor Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payment Payment @relation(fields: [paymentId], references: [id])
  due     FeeDue @relation(fields: [dueId], references: [id])

  @@unique([paymentId, dueId])
  @@index([dueId])
  @@map("payment_allocations")
}
