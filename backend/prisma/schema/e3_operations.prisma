// Domain E3 — Payroll, expenses, budgets (money-out side).
// Docs: 06-accounts-finance.md §3.4 · §3.6 · §3.8
// runByUserId / requestedByUserId / approvedByUserId are scalar actor-stamps.
// payslipFileId scalar (files → Domain L). month format "2026-08".

// A month of payroll. status DRAFT → APPROVED → PAID.
// The run carries denormalised gross/deductions/net totals (recomputed whenever
// an entry changes) so the hub never has to sum a page of entries to draw a
// headline. `totalMinor` is the NET total actually owed to staff.
model PayrollRun {
  id           String   @id @default(cuid())
  institutionId String
  month        String // "2026-08"
  status       String   @default("DRAFT") // DRAFT | APPROVED | PAID
  runByUserId  String // scalar → users.id
  approvedByUserId String? // scalar → users.id — locks the numbers
  approvedAt   DateTime?
  paidByUserId String? // scalar → users.id — set when the last entry is paid
  paidAt       DateTime?
  notes        String?
  grossMinor      Int   @default(0)
  deductionsMinor Int   @default(0)
  totalMinor      Int   @default(0) // net owed across all entries
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  entries PayrollEntry[]

  @@unique([institutionId, month])
  @@index([institutionId])
  @@index([institutionId, status])
  @@map("payroll_runs")
}

// One staff member's month. The staff identity (employeeNo / designation /
// departmentName / bankAccountLast4) is SNAPSHOT onto the entry: a payslip is a
// historical document and must keep saying what was true when it was raised.
// earningsJson / deductionsJson are [{ label, amountMinor }] in paise — the
// payslip lines. gross/deductions/net are their sums, kept denormalised so no
// reader has to parse JSON to add a column up.
model PayrollEntry {
  id            String    @id @default(cuid())
  payrollRunId  String
  staffUserId   String // scalar → users.id
  employeeNo    String? // snapshot
  designation   String? // snapshot
  departmentName String? // snapshot
  bankAccountLast4 String? // snapshot — only ever the last 4
  grossMinor    Int
  deductionsMinor Int     @default(0)
  netMinor      Int
  lopDays       Int       @default(0) // loss-of-pay days applied this month
  earningsJson  String    @default("[]") // [{ label, amountMinor }]
  deductionsJson String   @default("[]") // [{ label, amountMinor }]
  note          String?
  status        String    @default("PENDING") // PENDING | PAID
  paidAt        DateTime?
  paidByUserId  String? // scalar → users.id
  paymentRef    String? // UTR / cheque / transfer reference
  // A generated PDF is a REAL FILE row, so the link is a relation rather than a
  // bare scalar: the app has to be able to say "payslip.pdf, 34 KB" and open it,
  // which it cannot do with an id alone.
  payslipFileId String?
  payslip  File?   @relation("PayrollPayslip", fields: [payslipFileId], references: [id])
  // Which salary VERSION priced this entry. A payslip is a historical document,
  // so it must keep pointing at the record that was in force in THIS month even
  // after the next raise closes that record's window.
  salaryRecordId String? // scalar → staff_salary_records.id
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  payrollRun PayrollRun @relation(fields: [payrollRunId], references: [id])

  @@unique([payrollRunId, staffUserId])
  @@index([payrollRunId])
  @@index([staffUserId])
  @@map("payroll_entries")
}

// A claim for money spent. This is a document in its own right, so it keeps a
// SNAPSHOT of what it was for: `title` and `note` say what the money bought,
// `vendor` is the name as written on the bill (not a foreign key — the same
// vendor is spelled differently by three different departments), and `taxMinor`
// is separated so a reader can see what is recoverable.
//
// Approval is a decision, so it carries WHO and WHEN and — for a rejection —
// WHY. A rejection with no reason is unauditable, which is the same argument
// that put `waivedByUserId` on the dues desk.
//
// `departmentId` is denormalised from the chosen budget so department-wise
// expenditure is answerable without a join through a budget that may itself be
// re-pointed later.
model Expense {
  id                String   @id @default(cuid())
  institutionId     String
  category          String // LABS | EVENTS | MAINTENANCE | UTILITIES | MISC
  vendor            String?
  amountMinor       Int
  date              DateTime
  status            String   @default("PENDING") // PENDING | APPROVED | REJECTED
  requestedByUserId String // scalar → users.id
  approvedByUserId  String? // scalar → users.id
  budgetId          String?

  title             String?  // what the money bought — the line on the claim
  note              String?  // anything an approver needs and the category cannot say
  subcategory       String?  // finer grain than the five categories (e.g. "Chairs", "Bus fare")
  departmentId      String?  // scalar → departments.id (null = institution-wide)
  paymentMethod     String?  // CASH | BANK_TRANSFER | UPI | CHEQUE | CARD
  paymentReference  String?  // UTR / cheque no / txn id
  taxMinor          Int      @default(0) // GST/VAT carved out of amountMinor
  approvedAt        DateTime?
  approvedByName    String?  // snapshot, so a historic claim still says who signed it
  rejectedAt        DateTime?
  rejectedByUserId  String?  // scalar → users.id
  rejectionReason   String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  budget Budget? @relation(fields: [budgetId], references: [id])
  documents ExpenseDocument[]

  @@index([institutionId])
  @@index([status])
  @@index([institutionId, date])
  @@index([departmentId])
  @@index([vendor])
  @@map("expenses")
}

// A receipt, invoice or quote attached to a claim.
//
// The bytes live in object storage behind `File.storageKey`; this row records
// WHAT the document is in the context of the claim, which storage alone cannot
// express. `kind` matters to an approver: a quotation is what the spend was
// justified against, an invoice is what proves it happened, and a receipt is
// what proves it was paid.
model ExpenseDocument {
  id             String   @id @default(cuid())
  institutionId  String
  expenseId      String
  fileId         String // scalar → files.id
  kind           String   @default("RECEIPT") // RECEIPT | INVOICE | QUOTATION
  note           String?
  uploadedByUserId String // scalar → users.id
  createdAt      DateTime @default(now())

  expense Expense @relation(fields: [expenseId], references: [id])
  // A document row without the file it points at is a reference, not a receipt.
  // Exposing the relation lets a claim list say "receipt.pdf, 240 KB" and open
  // it, rather than only reporting that some file exists somewhere.
  file File @relation(fields: [fileId], references: [id])

  @@unique([expenseId, fileId])
  @@index([expenseId])
  @@map("expense_documents")
}

model Budget {
  id            String   @id @default(cuid())
  institutionId String
  departmentId  String? // scalar → departments.id (institution-wide budget when null)
  fiscalYear    String // "2025-26"
  category      String
  plannedMinor  Int
  spentMinor    Int      @default(0) // denorm — RECOMPUTED from approved expenses, never incremented blindly
  note          String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  expenses Expense[]

  @@unique([institutionId, fiscalYear, category, departmentId])
  @@index([institutionId])
  @@index([departmentId])
  @@map("budgets")
}

// ── F-06 Payroll, part 2: salary records, allowances, deductions, attendance ──
//
// Everything above describes a payroll RUN — one month, one sheet of payslips.
// What was missing is the thing that decides what those runs are worth: a
// per-person salary record that a finance officer can actually open, change and
// audit. `StaffProfile.monthlyGrossMinor` was a single mutable integer with no
// author, no date and no history, so "why did this person's salary change" had
// no answer and a raise silently rewrote last month's payslip basis.
//
// So a salary is a VERSIONED RECORD, not a field:
//
//   StaffSalaryRecord   one person's salary, effective over a window. Changing it
//                       closes the open record and opens the next one, so the
//                       run for March still prices at the salary that was in
//                       force in March — the same effective-date discipline the
//                       fee-structure desk uses.
//   StaffPayComponent   the ALLOWANCES and DEDUCTIONS that make up that salary
//                       (basic / HRA / DA / transport / PF / TDS / professional
//                       tax …), each a percentage of a named base or a flat
//                       amount. The old formula hard-coded 50/40/12; this is the
//                       same idea a college actually needs — a principal's HRA is
//                       not a maths constant.
//   StaffLoan           a salary advance or loan, recovered as a deduction over
//                       the months that follow. This is the deduction an Indian
//                       payroll desk is asked about every month and which no
//                       version of this schema could record.
//   StaffAttendanceSummary  one staff member's month: days present, paid leave,
//                       unpaid leave, and the loss-of-pay days that fall out of
//                       it. Kept as a summary rather than a join over class
//                       attendance because faculty attendance is a different
//                       thing from a student's register — and because the
//                       payroll month must be reproducible after the fact.
//
// Money: integer paise throughout (ADR-04). Every `…Minor` column is paise.

/// One version of one person's salary.
model StaffSalaryRecord {
  id              String    @id @default(cuid())
  institutionId   String
  staffUserId     String // scalar → users.id
  monthlyGrossMinor Int    // paise — the MONTHLY gross this record prices at
  basicMinor      Int       @default(0) // paise — the base most allowances/retirement are % of
  effectiveFrom   DateTime // the day this salary starts applying
  effectiveTo     DateTime? // null = still in force (open-ended window)
  reason          String?   // why it changed — "Annual increment", "Promotion"
  note            String?
  createdByUserId String // scalar → users.id — salary changes have an author
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  components StaffPayComponent[]

  // A person can only have ONE salary in force at a time. The service enforces
  // the overlap rule; this index is what makes the "is anything already open?"
  // check cheap rather than a table scan on every raise.
  @@index([institutionId, staffUserId])
  @@index([institutionId, staffUserId, effectiveFrom])
  @@map("staff_salary_records")
}

/// One allowance or deduction line inside a salary version.
/// `percentOf` names the BASE the percentage applies to ("BASIC", "GROSS") so a
/// component is a rule, not a number that was already multiplied by hand.
model StaffPayComponent {
  id             String  @id @default(cuid())
  salaryRecordId String
  kind           String  // EARNING | DEDUCTION
  code           String  // BASIC | HRA | DA | TRANSPORT | SPECIAL | PF | PROF_TAX | TDS | LOAN | OTHER
  label          String
  percentOf      String? // BASIC | GROSS | null (flat)
  percent        Int?    // whole percent, e.g. 40
  amountMinor    Int     @default(0) // flat paise — used when percentOf/percent are null
  isTaxable      Boolean @default(false) // taxable income (TDS is computed on this)
  sequence       Int     @default(0) // payslip print order
  note           String?

  salaryRecord StaffSalaryRecord @relation(fields: [salaryRecordId], references: [id], onDelete: Cascade)

  @@unique([salaryRecordId, code])
  @@index([salaryRecordId, kind])
  @@map("staff_pay_components")
}

/// A loan or salary advance recovered as a monthly deduction.
/// `recoveredMinor` is denormalised from `StaffLoanRecovery` rows (same
/// discipline as `Budget.spentMinor`) so "what is still owed" is one column and
/// not a per-row sum on every payslip.
model StaffLoan {
  id              String   @id @default(cuid())
  institutionId   String
  staffUserId     String // scalar → users.id
  kind            String   @default("LOAN") // LOAN | ADVANCE
  label           String   // "Festival advance", "Staff welfare loan"
  principalMinor  Int      // paise — how much was given
  installmentMinor Int     // paise — recovered per month (0 = manual)
  recoveredMinor  Int      @default(0) // paise — denorm, sum of recoveries
  grantedMonth    String   // "2026-08" — not paid before this month
  status          String   @default("ACTIVE") // ACTIVE | CLOSED | CANCELLED
  note            String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  recoveries StaffLoanRecovery[]

  @@unique([institutionId, staffUserId, label, grantedMonth])
  @@index([institutionId, status])
  @@index([staffUserId])
  @@map("staff_loans")
}

/// One month's recovery against a loan — the audit trail for the denormalised
/// `StaffLoan.recoveredMinor`, and what makes "₹4,000 recovered in August" an
/// answerable question rather than an inference.
model StaffLoanRecovery {
  id         String   @id @default(cuid())
  loanId     String
  month      String   // "2026-08"
  amountMinor Int     // paise
  note       String?
  createdAt  DateTime @default(now())

  loan StaffLoan @relation(fields: [loanId], references: [id], onDelete: Cascade)

  @@unique([loanId, month])
  @@index([month])
  @@map("staff_loan_recoveries")
}

/// One staff member's attendance for one payroll month.
///
/// Faculty attendance is NOT the student register: there is no offering, no
/// session and no per-student row. So this is a monthly summary the desk
/// maintains or derives from approved leave, and it is the ONLY input that makes
/// a payslip's loss-of-pay line traceable to a source rather than a typed number.
model StaffAttendanceSummary {
  id             String   @id @default(cuid())
  institutionId  String
  staffUserId    String // scalar → users.id
  month          String // "2026-08"
  workingDays    Int      // days the person was on the roster
  presentDays    Int      @default(0)
  paidLeaveDays  Int      @default(0)
  unpaidLeaveDays Int     @default(0) // THESE become loss of pay
  lopDays        Int      @default(0) // paise-free day count — may be edited down (partial day)
  source         String   @default("MANUAL") // MANUAL | LEAVE_SYNC
  note           String?
  updatedByUserId String? // scalar → users.id
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([institutionId, staffUserId, month])
  @@index([institutionId, month])
  @@map("staff_attendance_summaries")
}
