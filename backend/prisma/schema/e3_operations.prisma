// Domain E3 — Payroll, expenses, budgets (money-out side).
// Docs: 06-accounts-finance.md §3.4 · §3.6 · §3.8
// runByUserId / requestedByUserId / approvedByUserId are scalar actor-stamps.
// payslipFileId scalar (files → Domain L). month format "2026-08".

// A month of payroll. status DRAFT → APPROVED → PAID.
// The run carries denormalised gross/deductions/net totals (recomputed whenever
// an entry changes) so the hub never has to sum a page of entries to draw a
// headline. `totalMinor` is the NET total actually owed to staff.
model PayrollRun {
  id           String   @id @default(cuid())
  institutionId String
  month        String // "2026-08"
  status       String   @default("DRAFT") // DRAFT | APPROVED | PAID
  runByUserId  String // scalar → users.id
  approvedByUserId String? // scalar → users.id — locks the numbers
  approvedAt   DateTime?
  paidByUserId String? // scalar → users.id — set when the last entry is paid
  paidAt       DateTime?
  notes        String?
  grossMinor      Int   @default(0)
  deductionsMinor Int   @default(0)
  totalMinor      Int   @default(0) // net owed across all entries
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  entries PayrollEntry[]

  @@unique([institutionId, month])
  @@index([institutionId])
  @@index([institutionId, status])
  @@map("payroll_runs")
}

// One staff member's month. The staff identity (employeeNo / designation /
// departmentName / bankAccountLast4) is SNAPSHOT onto the entry: a payslip is a
// historical document and must keep saying what was true when it was raised.
// earningsJson / deductionsJson are [{ label, amountMinor }] in paise — the
// payslip lines. gross/deductions/net are their sums, kept denormalised so no
// reader has to parse JSON to add a column up.
model PayrollEntry {
  id            String    @id @default(cuid())
  payrollRunId  String
  staffUserId   String // scalar → users.id
  employeeNo    String? // snapshot
  designation   String? // snapshot
  departmentName String? // snapshot
  bankAccountLast4 String? // snapshot — only ever the last 4
  grossMinor    Int
  deductionsMinor Int     @default(0)
  netMinor      Int
  lopDays       Int       @default(0) // loss-of-pay days applied this month
  earningsJson  String    @default("[]") // [{ label, amountMinor }]
  deductionsJson String   @default("[]") // [{ label, amountMinor }]
  note          String?
  status        String    @default("PENDING") // PENDING | PAID
  paidAt        DateTime?
  paidByUserId  String? // scalar → users.id
  paymentRef    String? // UTR / cheque / transfer reference
  payslipFileId String? // scalar → files.id (Domain L)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  payrollRun PayrollRun @relation(fields: [payrollRunId], references: [id])

  @@unique([payrollRunId, staffUserId])
  @@index([payrollRunId])
  @@index([staffUserId])
  @@map("payroll_entries")
}

model Expense {
  id                String   @id @default(cuid())
  institutionId     String
  category          String // LABS | EVENTS | MAINTENANCE | UTILITIES | MISC
  vendor            String?
  amountMinor       Int
  date              DateTime
  status            String   @default("PENDING") // PENDING | APPROVED | REJECTED
  requestedByUserId String // scalar → users.id
  approvedByUserId  String? // scalar → users.id
  budgetId          String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  budget Budget? @relation(fields: [budgetId], references: [id])

  @@index([institutionId])
  @@index([status])
  @@map("expenses")
}

model Budget {
  id            String   @id @default(cuid())
  institutionId String
  departmentId  String? // scalar → departments.id (institution-wide budget when null)
  fiscalYear    String // "2025-26"
  category      String
  plannedMinor  Int
  spentMinor    Int      @default(0) // denorm, recomputed on expense approval
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  expenses Expense[]

  @@unique([institutionId, fiscalYear, category, departmentId])
  @@index([institutionId])
  @@map("budgets")
}
