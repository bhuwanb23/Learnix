# Learnix — environment variables
# Copy to .env and fill in real values.

# ── Backend ─────────────────────────────────────────────────
DATABASE_URL="postgresql://learnix:learnix_secret@localhost:5432/learnix"
PORT=4000
NODE_ENV=development

# Auth — use strong random values in production
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret"
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d
BCRYPT_ROUNDS=10

# CORS — comma-separated origin allowlist
CORS_ORIGIN="http://localhost:8081"

# Trust proxy (set true behind nginx/load balancer)
TRUST_PROXY=false

# ── Web (Expo) ──────────────────────────────────────────────
# EXPO_PUBLIC_API_URL=http://localhost:4000/api/v1
